# Copy to .env and fill in only what you need. Never commit .env.

PORT=8787

# Clerk authentication. Use development keys locally and production keys on Railway.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Comma-separated trusted app origins. Defaults to APP_URL, or the current origin locally.
# CLERK_AUTHORIZED_PARTIES=http://localhost:8787
# Bootstrap/fallback admin. This email becomes an admin the first time it signs in.
PINE_ADMIN_EMAIL=

# Impect: short lists, KPI profiles and player linking. Leave out to run without them.
# IMPECT_USERNAME=
# IMPECT_PASSWORD=

# Hosting.
# APP_URL=https://your-deployment.example.com
# PINE_DB=data/pine.db
# PHYS_DATA_URL=
# PINE_BACKUP_TOKEN=generate-a-long-random-value

# scripts/pull-backup.sh: which deployment to back up.
# PINE_URL=https://your-deployment.example.com
