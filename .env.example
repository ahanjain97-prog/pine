# Copy to .env and fill in only what you need. Never commit .env.

# Local development: no sign-in; pick who you are from the name menu in the top bar.
PINE_AUTH=off
PORT=8787

# Impect: short lists, KPI profiles and player linking. Leave out to run without them.
# IMPECT_USERNAME=
# IMPECT_PASSWORD=

# One shared password in front of the whole site (browser prompt). Leave out locally.
# PINE_SITE_PASSWORD=

# Sign-in (used when PINE_AUTH is not "off"): email + password, set up through links from the Staff page.
# PINE_ADMIN_EMAIL=

# Hosting.
# APP_URL=https://your-deployment.example.com
# PINE_DB=data/pine.db
# PHYS_DATA_URL=

# scripts/pull-backup.sh: which deployment to back up, and the key it downloads with
# (set the same PINE_BACKUP_TOKEN on the deployment).
# PINE_URL=https://your-deployment.example.com
# PINE_BACKUP_TOKEN=

# Player cards: the key the card worker (on the Mac mini) claims jobs and uploads PDFs with
# (set the same PINE_WORKER_TOKEN on the deployment and in the worker's settings). Leave it out and
# cards can still be requested, but nothing picks them up.
# PINE_WORKER_TOKEN=
