<?xml version="1.0" encoding="UTF-8"?>
<!-- Daily PINE database backup to ~/pine-backups.
     Install:   cp ~/pine/scripts/com.pine.backup.plist ~/Library/LaunchAgents/
                launchctl load ~/Library/LaunchAgents/com.pine.backup.plist
     Remove:    launchctl unload ~/Library/LaunchAgents/com.pine.backup.plist
                rm ~/Library/LaunchAgents/com.pine.backup.plist
     Run now:   launchctl start com.pine.backup
     Log:       ~/pine-backups/backup.log -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.pine.backup</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>PINE_SCRIPT_PATH</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>13</integer><key>Minute</key><integer>30</integer></dict>
  <!-- If the Mac was asleep at 13:30, run at the next wake. -->
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>PINE_LOG_PATH</string>
  <key>StandardErrorPath</key><string>PINE_LOG_PATH</string>
</dict>
</plist>
